# Database (TiDB Serverless)
DATABASE_URL=mysql://user:password@host:port/dbname?ssl={"rejectUnauthorized":true}
DB_HOST=host
DB_USER=user
DB_PASSWORD=password
DB_NAME=dbname
DB_PORT=4000

# Server
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# API routing
# Leave NEXT_PUBLIC_API_URL empty on Vercel when /api is served from the same origin.
NEXT_PUBLIC_API_URL=
INTERNAL_API_URL=http://localhost:3001

# Observability
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
NEXT_PUBLIC_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0

# Auth
JWT_SECRET=your-super-secure-jwt-secret-key-change-me

# Firebase (Client)
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-auth-domain
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-storage-bucket
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your-measurement-id
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id

# Observability
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
SENTRY_RELEASE=

# AI (Quick Add NLP) — OpenRouter
# Any OpenAI-compatible provider works (OpenRouter, Gemini, DeepSeek, etc.)
# Docs: https://openrouter.ai/docs
AI_API_KEY=your-api-key
AI_API_KEY_2=
AI_MODEL=inclusionai/ring-2.6-1t:free
AI_BASE_URL=https://openrouter.ai/api/v1

# Firebase Admin (Server)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
