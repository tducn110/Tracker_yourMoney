import { and, eq, isNull, between } from "drizzle-orm";
import { transactions, type Transaction, type NewTransaction } from "../schema/transactions";
import { BaseRepository, type DB } from "./base-repository";

/**
 * Repository for Transaction operations.
 * Centralizes data access for financial ledger entries.
 */
export class TransactionRepository extends BaseRepository {
  /**
   * Create a new transaction.
   * Supports cross-instance idempotency via the idempotencyKey constraint in DB.
   */
  async create(data: NewTransaction, tx?: DB) {
    const client = tx || this.db;
    // @ts-ignore
    const [result] = await client.insert(transactions).values(data);
    
    // cast to any/string to handle TiDB/MySQL2 return type variations
    const id = (result as any).insertId || (result as any).lastInsertId;
    const [newTx] = await client.select().from(transactions).where(eq(transactions.id, Number(id))).limit(1);
    
    return newTx || null;
  }

  /**
   * Find a transaction by ID and userId.
   */
  async findById(id: number, userId: number, tx?: DB) {
    const client = tx || this.db;
    const [record] = await client
      .select()
      .from(transactions)
      .where(
        and(
          eq(transactions.id, id),
          eq(transactions.userId, userId),
          isNull(transactions.deletedAt)
        )
      )
      .limit(1);
    
    return record || null;
  }

  /**
   * Find all transactions for a user, including category details.
   */
  async findAll(userId: number, tx?: DB) {
    const client = tx || this.db;
    const { categories } = await import("../schema/categories");
    
    return client
      .select({
        id: transactions.id,
        amount: transactions.amount,
        type: transactions.type,
        note: transactions.note,
        displayDate: transactions.displayDate,
        createdAt: transactions.createdAt,
        category: {
          name: categories.name,
          icon: categories.icon
        }
      })
      .from(transactions)
      .leftJoin(categories, eq(transactions.categoryId, categories.id))
      .where(
        and(
          eq(transactions.userId, userId),
          isNull(transactions.deletedAt)
        )
      )
      .orderBy(transactions.displayDate);
  }

  /**
   * Find transactions within a date range (Inclusive).
   * Crucial for S2S (Safe-to-Spend) calculations and reports.
   */
  async findByDateRange(userId: number, startDate: string, endDate: string, tx?: DB) {
    const client = tx || this.db;
    return client
      .select()
      .from(transactions)
      .where(
        and(
          eq(transactions.userId, userId),
          between(transactions.displayDate, startDate, endDate),
          isNull(transactions.deletedAt)
        )
      )
      .orderBy(transactions.displayDate);
  }

  /**
   * Update a transaction.
   */
  async update(id: number, userId: number, data: Partial<NewTransaction>, tx?: DB) {
    const client = tx || this.db;
    await client
      .update(transactions)
      .set({ ...data, updatedAt: new Date() })
      .where(
        and(
          eq(transactions.id, id),
          eq(transactions.userId, userId),
          isNull(transactions.deletedAt)
        )
      );
    
    return this.findById(id, userId, client);
  }

  /**
   * Soft delete a transaction.
   */
  async delete(id: number, userId: number, tx?: DB) {
    const client = tx || this.db;
    await client
      .update(transactions)
      .set({ deletedAt: new Date() })
      .where(
        and(
          eq(transactions.id, id),
          eq(transactions.userId, userId)
        )
      );
  }
}
</file>

