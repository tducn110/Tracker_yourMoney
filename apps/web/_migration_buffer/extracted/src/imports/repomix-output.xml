                  <div className="flex gap-3">
                    <button
                      type="button"
                      onClick={() => setFormData({ ...formData, type: "income" })}
                      className={`flex-1 py-3 rounded-xl border-2 transition-all font-medium ${formData.type === "income" ? "border-emerald-500 bg-emerald-50 text-emerald-600" : "border-slate-200 bg-white text-slate-500 hover:border-slate-300"}`}
                      aria-pressed={formData.type === "income"}
