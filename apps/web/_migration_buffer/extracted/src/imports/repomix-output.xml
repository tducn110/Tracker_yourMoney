import { clsx, type ClassValue } from "clsx";
import { twMerge } from "tailwind-merge";

export function cn(...inputs: ClassValue[]) {
  return twMerge(clsx(inputs));
}

/**
 * Validates a string against a standard Hex color regex.
 */
export function isValidHex(color: string): boolean {
  return /^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$/.test(color);
}

/**
 * Sanitizes dynamic color inputs to prevent CSS injection.
 * @param color The primary color to validate.
 * @param fallback An optional secondary fallback color to validate.
 * @returns A validated Hex color, or #CCCCCC as an absolute safeguard.
 */
export function safeColor(color?: string, fallback: string = "#CCCCCC"): string {
  if (color && isValidHex(color)) return color;
  if (isValidHex(fallback)) return fallback;
  return "#CCCCCC"; // Last resort hardcoded safeguard
}
