import { AnalyticsRepository } from "@finance/db/src/repositories/analytics.repo";
import { calculateS2SValue } from "./lib/finance-utils";

/**
 * Service for Safe-to-Spend (S2S) calculations.
 * Orchestrates data fetching via AnalyticsRepository and uses pure math from lib/finance-utils.
 */
export class S2SService {
  constructor(private readonly analyticsRepository: AnalyticsRepository) {}

  async getSafeToSpend(userId: number, month: string) {
    // 1. Fetch all required data in parallel
    const [summary, config, billsTotal, goalsAllocation] = await Promise.all([
      this.analyticsRepository.getMonthlySummary(userId, month),
      this.analyticsRepository.getUserConfig(userId),
      this.analyticsRepository.getActiveBillsTotal(userId),
      this.analyticsRepository.getActiveGoalsAllocation(userId),
    ]);

    // 2. Perform pure calculation
    const result = calculateS2SValue({
      income: summary.totalIncome,
      expense: summary.totalExpense,
      fixedCosts: billsTotal,
      goalsAllocation: goalsAllocation,
      emergencyBuffer: config?.emergencyBuffer ?? "0",
    });

    return {
      safeToSpend: result.amount,
      isOverBudget: result.isOverBudget,
      totalIncome: summary.totalIncome,
      totalExpense: summary.totalExpense,
      fixedCostsPending: billsTotal,
      goalsAllocation: goalsAllocation,
      emergencyBuffer: config?.emergencyBuffer ?? "0",
      monthlyBudget: config?.monthlyBudget ?? "0",
      period: month,
    };
  }
}
