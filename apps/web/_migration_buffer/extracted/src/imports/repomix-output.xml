                  </button>
                </div>

                {/* Form */}
                <form onSubmit={handleSubmit} className="space-y-6">
                  {/* Name */}
                  <div>
                    <label className="block text-[14px] font-medium mb-2" style={{ color: "#475569" }}>
                      Tên Danh Mục
                    </label>
                    <input
                      type="text"
