import { createMiddleware } from "hono/factory";

/**
 * Recursively scans an object and converts all BigInt values to strings.
 * This ensures safe JSON serialization without monkey-patching globals.
 */
export function transformBigInt(obj: any): any {
  if (obj === null || obj === undefined) return obj;
  
  if (typeof obj === "bigint") {
    return obj.toString();
  }
  
  if (Array.isArray(obj)) {
    return obj.map(transformBigInt);
  }
  
  if (typeof obj === "object") {
    const newObj: any = {};
    for (const key in obj) {
      if (Object.prototype.hasOwnProperty.call(obj, key)) {
        newObj[key] = transformBigInt(obj[key]);
      }
    }
    return newObj;
  }
  
  return obj;
}

/**
 * Hono middleware to intercept JSON responses and stringify BigInts.
 */
export const bigintTransformer = createMiddleware(async (c, next) => {
  await next();
  
  const contentType = c.res.headers.get("content-type");
  if (contentType?.includes("application/json")) {
    const originalBody = await c.res.json();
    const transformedBody = transformBigInt(originalBody);
    
    // Create a new response with the transformed body
    // Preserve existing headers and status
    c.res = new Response(JSON.stringify(transformedBody), {
      status: c.res.status,
      statusText: c.res.statusText,
      headers: c.res.headers,
    });
  }
});
