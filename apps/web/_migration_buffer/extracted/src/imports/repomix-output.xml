                    className="w-full px-4 py-3 rounded-xl border border-slate-200 bg-slate-50 text-slate-800 text-[15px] outline-none transition-all focus:border-blue-500 focus:ring-1 focus:ring-blue-500"
                    required
                  />
                </div>

                <fieldset>
                  <legend className="block text-[14px] font-medium mb-2 text-slate-600">
                    Loại
