                      >
                        <div className="w-8 h-8 rounded-full bg-white shadow-sm flex items-center justify-center text-sm flex-shrink-0">
                          💳
                        </div>
                        <div className="flex-1 min-w-0">
                          <p className="text-[12px] font-bold text-slate-900 truncate">{bill.name}</p>
                          <p className={`text-[10px] font-semibold ${isOverdue ? "text-red-500" : "text-slate-400"}`}>
                            {isOverdue ? "⚠️ Quá hạn!" : isPaid ? "✅ Đã thanh toán" : `Ngày ${bill.dueDay}`}
                          </p>
                        </div>
                        <p className="text-[12px] font-black text-slate-800 flex-shrink-0">
                          {formatVND(Number(bill.amount))}
                        </p>
                      </motion.div>
                    );
                  }) : (
                    <div className="text-slate-400 text-[11px] py-4 text-center">
                      Không có hóa đơn tới hạn.
                    </div>
                  )}
                </div>
                <div className="mt-4 pt-4 border-t border-slate-100 flex justify-between items-center">
                  <span className="text-[11px] font-semibold text-slate-400">Bills tới hạn</span>
