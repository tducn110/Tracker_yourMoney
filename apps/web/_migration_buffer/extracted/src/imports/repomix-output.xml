          <p className="text-[20px] font-bold text-slate-800">{filtered.length}</p>
        </div>
        <div className="bg-white rounded-2xl p-4 shadow-sm border border-gray-100">
          <p className="text-[12px] font-medium mb-1 text-slate-500">Tổng Thu</p>
          <p className="text-[20px] font-bold text-emerald-500">+{formatVND(totalIncome)}</p>
        </div>
        <div className="bg-white rounded-2xl p-4 shadow-sm border border-gray-100">
          <p className="text-[12px] font-medium mb-1 text-slate-500">Tổng Chi</p>
          <p className="text-[20px] font-bold text-red-500">-{formatVND(totalExpense)}</p>
        </div>
        <div className="md:col-span-1 bg-blue-50/50 rounded-2xl p-3 border border-blue-100 flex flex-col justify-center">
            <div className="relative">
                <label htmlFor="quick-add-text" className="sr-only">Nhập nhanh giao dịch</label>
                <input 
                    id="quick-add-text"
                    name="quick-add-text"
                    placeholder="Nhập nhanh: 50k ăn sáng..."
                    className="w-full px-3 py-2 rounded-xl border border-blue-200 text-[13px] outline-none focus:ring-2 focus:ring-blue-400/50 transition-all text-slate-800 bg-white"
                    onKeyDown={async (e) => {
                      if (e.key === 'Enter') {
                        const target = e.target as HTMLInputElement;
                        const text = target.value.trim();
                        if (!text) return;

                        // Optimistic update — show item immediately
                        const tempId = Date.now();
                        const optimisticTx: TransactionUI = {
                          id: tempId,
                          userId: 'optimistic',
                          categoryId: 0,
                          amount: -50000,
                          type: "expense" as const,
                          note: text,
                          category: "Khác",
                          icon: "📦",
                          date: "Hôm nay",
                          displayDate: new Date().toISOString(),
                          source: 'manual',
                          createdAt: new Date().toISOString()
                        };
                        setTransactions(prev => [optimisticTx, ...prev]);
                        target.value = '';

                        try {
                          await apiClient.quickAddTransaction(text);
                        } catch {
                          // Rollback on failure
                          setTransactions(prev => prev.filter(tx => String(tx.id) !== String(tempId)));
                        }
                      }
                    }}
                />
                <button 
                  type="button" 
                  onClick={async (e) => {
                    const input = (e.currentTarget.previousSibling as HTMLInputElement);
                    const text = input.value.trim();
                    if (!text) return;

                    const tempId = Date.now();
                    const optimisticTx: TransactionUI = {
                      id: tempId,
                      userId: 'optimistic',
                      categoryId: 0,
                      amount: -50000,
                      type: "expense" as const,
                      note: text,
                      category: "Khác",
                      icon: "📦",
                      date: "Hôm nay",
                      displayDate: new Date().toISOString(),
                      source: 'manual',
                      createdAt: new Date().toISOString()
                    };
                    setTransactions(prev => [optimisticTx, ...prev]);
                    input.value = '';

                    try {
                      await apiClient.quickAddTransaction(text);
                    } catch {
                      setTransactions(prev => prev.filter(tx => String(tx.id) !== String(tempId)));
                    }
                  }}
                  className="absolute right-2 top-1/2 -translate-y-1/2 text-blue-500 hover:text-blue-600 font-bold text-[12px]"
                >Thêm</button>
            </div>
        </div>
      </div>

      {/* Filters */}
      <div className="bg-white rounded-2xl p-4 shadow-sm border border-gray-100">
        <div className="flex flex-col sm:flex-row gap-3">
          <select
            value={selectedMonth}
            onChange={(e) => { setSelectedMonth(e.target.value); setCurrentPage(1); }}
            className="px-3 py-2.5 rounded-xl border text-[14px] outline-none border-slate-200 text-slate-800 bg-slate-50"
            title="Chọn tháng"
          >
            {months.map((m) => <option key={m}>{m}</option>)}
          </select>

          <select
            value={selectedCategory}
            onChange={(e) => { setSelectedCategory(e.target.value); setCurrentPage(1); }}
            className="px-3 py-2.5 rounded-xl border text-[14px] outline-none border-slate-200 text-slate-800 bg-slate-50"
            title="Chọn danh mục"
          >
            <option>Tất cả</option>
            {mockCategories.map((c: any) => <option key={c.id}>{c.name}</option>)}
          </select>

          <div className="flex-1 flex items-center gap-2 px-3 py-2.5 rounded-xl border border-slate-200 bg-slate-50">
            <Search size={15} className="text-slate-400" />
            <input
              type="text"
              value={search}
              onChange={(e) => { setSearch(e.target.value); setCurrentPage(1); }}
              placeholder="Tìm kiếm giao dịch..."
              className="flex-1 bg-transparent outline-none text-[14px] text-slate-800"
              title="Tìm kiếm giao dịch"
            />
          </div>
        </div>
      </div>

      {/* Table */}
      <div className="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
        <div className="overflow-x-auto">
          <table className="w-full">
            <thead>
              <tr className="bg-slate-50 border-b border-slate-100">
                <th className="text-left px-5 py-3 text-[12px] font-semibold text-slate-500">Ngày</th>
                <th className="text-left px-5 py-3 text-[12px] font-semibold text-slate-500">Ghi chú</th>
                <th className="text-left px-5 py-3 text-[12px] font-semibold text-slate-500">Danh mục</th>
                <th className="text-right px-5 py-3 text-[12px] font-semibold text-slate-500">Số tiền</th>
                <th className="text-center px-5 py-3 text-[12px] font-semibold text-slate-500">Xóa</th>
              </tr>
            </thead>
            <tbody className="divide-y divide-slate-100">
              {paginated.length === 0 ? (
                <tr>
                  <td colSpan={5} className="text-center py-12 text-[14px] text-slate-400">
                    Không tìm thấy giao dịch nào 😔
                  </td>
                </tr>
              ) : (
                paginated.map((tx, index) => (
                  <tr
                    key={tx.id}
                    className={`hover:bg-blue-50/30 transition-colors ${index % 2 === 0 ? "bg-white" : "bg-slate-50/30"}`}
                  >
                    <td className="px-5 py-3.5">
                      <span className="text-[13px] text-slate-500">{tx.date}</span>
                    </td>
                    <td className="px-5 py-3.5">
                      <span className="text-[13px] font-medium text-slate-800">{tx.note}</span>
                    </td>
                    <td className="px-5 py-3.5">
                      <div className="flex items-center gap-2">
                        <span className="text-base">{tx.icon}</span>
                        <span className="text-[13px] text-slate-500">{tx.category}</span>
                      </div>
                    </td>
                    <td className="px-5 py-3.5 text-right">
                      <div className="flex items-center justify-end gap-1">
                        {tx.type === "income" ? (
                          <ArrowUpRight size={13} className="text-emerald-500" />
                        ) : (
                          <ArrowDownRight size={13} className="text-red-500" />
                        )}
                        <span
                          className={`text-[13px] font-semibold ${tx.type === "income" ? "text-emerald-500" : "text-red-500"}`}
                        >
                          {tx.type === "income" ? "+" : "-"}{formatVND(Number(tx.amount))}
                        </span>
                      </div>
                    </td>
                    <td className="px-5 py-3.5 text-center">
                      <button
                        onClick={() => handleDelete(tx.id)}
                        className="p-1.5 rounded-lg hover:bg-red-50 transition-colors text-red-500"
                        title="Xóa giao dịch"
                        aria-label={`Xóa giao dịch ${tx.note || ''}`}
                      >
                        <Trash2 size={15} />
                      </button>
                    </td>
                  </tr>
                ))
              )}
            </tbody>
          </table>
        </div>

        {/* Pagination */}
        {totalPages > 1 && (
          <div className="flex items-center justify-between px-5 py-3 border-t border-slate-100">
            <p className="text-[13px] text-slate-500">
              Hiển thị {(currentPage - 1) * ITEMS_PER_PAGE + 1}–{Math.min(currentPage * ITEMS_PER_PAGE, filtered.length)} / {filtered.length}
            </p>
            <div className="flex items-center gap-1">
              <button
                onClick={() => setCurrentPage((p) => Math.max(1, p - 1))}
                disabled={currentPage === 1}
                className="p-2 rounded-lg hover:bg-gray-100 disabled:opacity-40 transition-colors text-slate-500"
                title="Trang trước"
              >
                <ChevronLeft size={16} />
              </button>
              {Array.from({ length: totalPages }, (_, i) => i + 1).map((p) => (
                <button
                  key={p}
                  onClick={() => setCurrentPage(p)}
                  className={`w-8 h-8 rounded-lg text-[13px] font-medium transition-colors ${currentPage === p ? "bg-blue-500 text-white" : "text-slate-500 bg-transparent hover:bg-slate-100"}`}
                  title={`Trang ${p}`}
                >
                  {p}
                </button>
              ))}
              <button
                onClick={() => setCurrentPage((p) => Math.min(totalPages, p + 1))}
                disabled={currentPage === totalPages}
                className="p-2 rounded-lg hover:bg-gray-100 disabled:opacity-40 transition-colors text-slate-500"
                title="Trang sau"
              >
                <ChevronRight size={16} />
              </button>
            </div>
          </div>
        )}
      </div>

      <QuickAddModal open={quickAddOpen} onClose={() => setQuickAddOpen(false)} />
    </div>
  );
}
</file>

