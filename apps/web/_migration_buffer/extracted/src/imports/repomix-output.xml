// ─── Actor Badge ──────────────────────────────────────────────────────────────
function ActorBadge({ actor }: { actor: Actor }) {
  const config: Record<Actor, { label: string; colorClass: string; Icon: any }> = {
    user:   { label: "User",   colorClass: "text-blue-500 bg-blue-500/10 border-blue-500/30", Icon: User },
    system: { label: "System", colorClass: "text-purple-500 bg-purple-500/10 border-purple-500/30", Icon: Activity },
    api:    { label: "API",    colorClass: "text-amber-500 bg-amber-500/10 border-amber-500/30", Icon: Server },
    db:     { label: "DB",     colorClass: "text-slate-500 bg-slate-500/10 border-slate-500/30", Icon: Database },
  };
  const c = config[actor];
  return (
    <div
      className={`inline-flex items-center gap-1 px-2 py-0.5 rounded-full border ${c.colorClass}`}
      lang="en"
    >
      <c.Icon size={9} />
      <span className="text-[9px] font-bold">{c.label}</span>
    </div>
  );
}

// ─── Flow Step Card ───────────────────────────────────────────────────────────
function StepCard({
  step,
  isLast,
  flowColor,
  isSelected,
  onClick,
}: {
  step: FlowStep;
  isLast: boolean;
  flowColor: string;
  isSelected: boolean;
  onClick: () => void;
}) {
  return (
    <div className="flex flex-col items-center">
      <motion.div
        whileHover={{ scale: 1.03, y: -2 }}
        whileTap={{ scale: 0.98 }}
        onClick={onClick}
        className="w-44 lg:w-48 cursor-pointer"
        role="button"
        aria-pressed={isSelected}
        tabIndex={0}
        onKeyDown={(e) => e.key === 'Enter' && onClick()}
      >
        {/* Step number */}
        <div className="flex items-center gap-2 mb-2">
          <div
            className={`w-6 h-6 rounded-full flex items-center justify-center text-[10px] font-black text-white flex-shrink-0 transition-colors ${isSelected ? "bg-[var(--step-color)]" : "bg-slate-300"}`}
            style={isSelected ? ({ "--step-color": safeColor(flowColor) } as React.CSSProperties) : {}}
          >
            {step.id}
          </div>
          <ActorBadge actor={step.actor} />
        </div>

        {/* Card body */}
        <div
          className={`rounded-2xl p-3.5 border transition-all ${isSelected ? "shadow-md bg-[var(--card-bg)] border-[var(--card-border)]" : "bg-white border-slate-200 shadow-sm"}`}
          style={isSelected ? ({ 
            "--card-bg": `${safeColor(flowColor)}10`, 
            "--card-border": safeColor(flowColor),
            boxShadow: `0 4px 16px ${safeColor(flowColor)}20` 
          } as React.CSSProperties) : {}}
        >
          <div className="text-xl mb-2">{step.icon}</div>
          <p className="text-[12px] font-bold text-slate-900 leading-snug mb-1">{step.title}</p>
          <p className="text-[10px] text-slate-500 leading-relaxed line-clamp-2">{step.desc}</p>

          {step.stateChange && (
            <div className="mt-2 px-2 py-1 rounded-lg border bg-[var(--state-bg)] border-[var(--state-border)]"
              style={{ "--state-bg": `${safeColor(flowColor)}10`, "--state-border": `${safeColor(flowColor)}20` } as React.CSSProperties}>
              <p className="text-[8px] font-bold leading-tight" style={{ color: safeColor(flowColor) }}>
                {step.stateChange}
              </p>
            </div>
          )}

          {step.warning && (
            <div className="mt-2 flex items-start gap-1 px-2 py-1.5 rounded-lg bg-amber-50 border border-amber-200">
              <AlertTriangle size={9} className="text-amber-500 flex-shrink-0 mt-0.5" />
              <p className="text-[9px] text-amber-700 font-semibold">{step.warning}</p>
            </div>
          )}

          {step.isTerminal && (
            <div className="mt-2 flex items-center gap-1">
              <CheckCircle size={10} className="text-emerald-500" />
              <span className="text-[9px] font-bold text-emerald-600">Flow kết thúc</span>
            </div>
          )}
        </div>
      </motion.div>

      {/* Arrow */}
      {!isLast && (
        <div className="flex items-center justify-center h-8 w-full mt-2 mb-0">
          <div className="w-px h-6 border-l-2 border-dashed border-slate-300" />
        </div>
      )}
    </div>
  );
}

// ─── Step Detail Panel ────────────────────────────────────────────────────────
