<file path="apps/web/src/app/api/[...path]/route.ts">
import { NextRequest, NextResponse } from "next/server";

const API_TARGET = "http://localhost:8787";

/**
 * Next.js Sanitization Proxy
 * Filters out Cloudflare Worker runtime corruption (Error 65535)
 */
async function handler(req: NextRequest, context: { params: Promise<{ path: string[] }> }) {
  const { path: pathSegments } = await context.params;
  const path = pathSegments.join("/");
  const url = `${API_TARGET}/api/${path}${req.nextUrl.search}`;
  
  try {
    const body = (req.method !== "GET" && req.method !== "HEAD") ? await req.text() : undefined;
    
    // 🛡️ Forward only safe/essential headers
    const forwardHeaders = new Headers();
    const FORBIDDEN_HEADERS = new Set([
      "host",
      "connection",
      "content-length",
      "transfer-encoding",
      "keep-alive",
      "proxy-connection",
      "te",
      "upgrade",
      "sec-fetch-mode",
      "sec-fetch-dest",
      "sec-fetch-site",
    ]);

    req.headers.forEach((value, key) => {
      if (!FORBIDDEN_HEADERS.has(key.toLowerCase())) {
        forwardHeaders.set(key, value);
      }
    });

    // Ensure the target URL is well-formed
    const targetUrl = new URL(`${API_TARGET}/api/${path}`);
    req.nextUrl.searchParams.forEach((value, key) => {
      targetUrl.searchParams.set(key, value);
    });

    const fetchOptions: RequestInit = {
      method: req.method,
      headers: forwardHeaders,
      cache: "no-store",
    };

    if (body !== undefined) {
      fetchOptions.body = body;
      // @ts-ignore - duplex is required in some Node.js fetch implementations when passing a body
      fetchOptions.duplex = "half";
    }

    const response = await fetch(targetUrl.toString(), fetchOptions);

    let text = await response.text();
    
    // 🛡️ THE SANITIZER: Filter out Cloudflare Worker runtime artifacts (Error 65535)
    // Only sanitize if response is actually JSON or has corruption signs
    const isJsonResponse = response.headers.get("content-type")?.includes("application/json");
    
    if (isJsonResponse) {
      const firstBrace = text.indexOf("{");
      const firstBracket = text.indexOf("[");
      const start = firstBrace === -1 ? (firstBracket === -1 ? 0 : firstBracket) : (firstBracket === -1 ? firstBrace : Math.min(firstBrace, firstBracket));
      
      if (start > 0) {
        console.warn(`[Sanitizer] Stripped ${start} corrupt characters from API response at ${path}`);
        text = text.substring(start);
      }
    }

    // 🛡️ Build clean response headers
    const STRIP_RESPONSE_HEADERS = new Set([
      "content-encoding",
      "transfer-encoding",
      "connection",
      "keep-alive",
      "content-length",
    ]);

    const responseHeaders = new Headers();
    response.headers.forEach((value, key) => {
      if (!STRIP_RESPONSE_HEADERS.has(key.toLowerCase())) {
        responseHeaders.set(key, value);
      }
    });

    // Enforce standard JSON content type for sanitized matches
    if (isJsonResponse) {
      responseHeaders.set("content-type", "application/json; charset=utf-8");
    }

    return new NextResponse(text, {
      status: response.status,
      statusText: response.statusText,
      headers: responseHeaders,
    });
  } catch (error: any) {
    console.error(`[Proxy Error] ${req.method} ${path}:`, error.message || error);
    
    // Detailed error logging for debugging
    if (error.code === 'UND_ERR_NOT_SUPPORTED') {
      console.error("[Proxy Error] Node.js Fetch incompatibility detected. Check headers and body.");
    }

    return NextResponse.json(
      { success: false, error: "API_PROXY_ERROR", message: error.message }, 
      { status: 502 }
    );
  }
}

export const GET = handler;
export const POST = handler;
export const PUT = handler;
export const PATCH = handler;
export const DELETE = handler;
export const OPTIONS = handler;
</file>

