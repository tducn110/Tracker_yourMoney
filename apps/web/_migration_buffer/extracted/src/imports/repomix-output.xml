                  <div className="p-4 rounded-xl bg-slate-50 border border-slate-200">
                    <p className="text-[12px] font-bold text-slate-400 uppercase tracking-wider mb-3">
                      Bản xem trước
                    </p>
                    <div className="flex items-center gap-3">
                      <div
                        className="w-12 h-12 rounded-lg flex items-center justify-center text-[24px] bg-[var(--preview-bg)]"
                        style={{ "--preview-bg": `${safeColor(formData.color)}15` } as React.CSSProperties}
                        aria-hidden="true"
                      >
                        {formData.icon}
                      </div>
                      <div>
                        <div className="text-[15px] font-medium text-slate-800">
                          {formData.name || "Tên danh mục"}
                        </div>
                        <div className="text-[13px] text-slate-500">
                          {formData.type === "income" ? "Thu nhập" : "Chi tiêu"}
                        </div>
                      </div>
                    </div>
                  </div>

                <div className="flex gap-3 pt-2">
                  <button
                    type="button"
                    onClick={handleCancel}
                    className="flex-1 py-3 rounded-xl font-semibold text-slate-500 bg-slate-100 hover:bg-slate-200 transition-colors"
                  >
                    Hủy
                  </button>
                  <button
                    type="submit"
                    className="flex-1 py-3 rounded-xl font-semibold text-white bg-blue-500 hover:bg-blue-600 shadow-md shadow-blue-500/20 transition-all hover:brightness-105"
                  >
                    {editingId ? "Lưu Thay Đổi" : "Thêm Danh Mục"}
                  </button>
                </div>
              </form>
            </motion.div>
            </div>
          )
        }
      </AnimatePresence>
    </div>
  );
}
