import Decimal from "decimal.js";

/**
 * Pure calculation functions for Finance Tracker.
 * These functions have NO side effects and are easy to unit test.
 */

export interface S2SCalculationInput {
  income: string | number;
  expense: string | number;
  fixedCosts: string | number;
  goalsAllocation: string | number;
  emergencyBuffer: string | number;
}

/**
 * Core Safe-to-Spend (S2S) formula.
 * S2S = Income - Expense - FixedCosts - GoalsAllocation - EmergencyBuffer
 */
export function calculateS2SValue(input: S2SCalculationInput) {
  const inc = new Decimal(input.income);
  const exp = new Decimal(input.expense);
  const fix = new Decimal(input.fixedCosts);
  const gol = new Decimal(input.goalsAllocation);
  const buf = new Decimal(input.emergencyBuffer);

  const s2s = inc
    .minus(exp)
    .minus(fix)
    .minus(gol)
    .minus(buf);

  return {
    amount: s2s.toFixed(2),
    isOverBudget: s2s.isNegative(),
    raw: s2s
  };
}

/**
 * Format currency to human readable string (VND focus).
 */
export function formatCurrencyVND(amount: string | number | Decimal) {
  const val = new Decimal(amount);
  return new Intl.NumberFormat("vi-VN", {
    style: "currency",
    currency: "VND",
  }).format(val.toNumber());
}

/**
 * Calculate percentage of budget used.
 */
export function calculateBudgetUsage(expense: string | number, budget: string | number) {
  const exp = new Decimal(expense);
  const bud = new Decimal(budget);
  
  if (bud.isZero()) return "0";
  return exp.dividedBy(bud).times(100).toFixed(1);
}
