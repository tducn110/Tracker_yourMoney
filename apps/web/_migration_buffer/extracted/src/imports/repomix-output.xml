                <div className="flex items-center justify-between mb-5">
                  <h3 className="font-bold text-slate-900 text-[15px] flex items-center gap-2">
                    <Target size={16} className="text-orange-500" />
                    Mục Tiêu Tiết Kiệm
                  </h3>
                  <Link
                    href="/goals"
                    className="flex items-center gap-1 text-[12px] font-semibold text-blue-500 hover:text-blue-600 transition-colors"
                  >
                    Tất cả <ChevronRight size={14} />
                  </Link>
                </div>
                <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  {(goals || []).length > 0 ? (goals || []).slice(0, 4).map((goal) => {
                    const current = Number(goal.currentSaved || 0);
                    const target = Number(goal.targetAmount || 1);
                    const pct = Math.min(Math.round((current / target) * 100), 100);
                    const statusColor =
                      goal.status === "completed"
                        ? "from-emerald-500 to-green-500"
                        : goal.status === "paused"
                          ? "from-slate-300 to-slate-400"
                          : "from-blue-500 to-indigo-500";
                    return (
                      <div key={goal.id} className="group p-4 rounded-xl bg-slate-50/60 hover:bg-white border border-slate-100/60 hover:border-slate-200 hover:shadow-sm transition-all">
                        <div className="flex items-center justify-between mb-2.5">
                          <div className="flex items-center gap-2">
                            <span className="text-xl">🎯</span>
                            <div>
                              <p className="text-[12px] font-bold text-slate-800 leading-tight">{goal.name}</p>
                              <p className="text-[10px] text-slate-400 mt-0.5">
                                {goal.status === "completed" ? "✅ Hoàn thành" : goal.status === "paused" ? "⏸ Tạm dừng" : `Vốn: ${formatVND(target)}`}
                              </p>
                            </div>
                          </div>
                          <span className="text-[13px] font-black text-slate-800">{pct}%</span>
