<file path="apps/web/src/app-pages/Dashboard.tsx">
/**
 * Dashboard — Finance Tracker V3
 * Layout order (Antigravity V1.2):
 *  HÀNG 1 — S2S Hero (full-width, dark, ~2.5× card phụ)
 *  HÀNG 2 — 3 Metric Cards (demoted, subdued)
 *  HÀNG 3 — Cash Wallet Strip (isolated horizontal)
 *  HÀNG 4 — Transactions + Goals (left 8/12) | Bills (right 4/12)
 */

"use client";

import React, { useState, useEffect, useRef } from "react";
import {
  TrendingUp,
  TrendingDown,
  Wallet,
  CreditCard,
  Target,
  Calendar,
  ChevronRight,
  MessageCircle,
} from "lucide-react";
import { motion } from "motion/react";
import Link from "next/link";
import {
  formatVND,
  mockS2SData,
} from "../data/mockData";
import ChatQuickAdd from "../components/ChatQuickAdd";
import { S2SHeroSection } from "../components/S2SHeroSection";
import { CashWalletStrip } from "../components/CashWalletStrip";
import { QuickInputBar } from "../components/QuickInputBar";
import { DashboardSkeleton } from "../components/DashboardSkeleton";
import {
  useFinanceData,
  useTransactions,
  useGoals,
  useBills,
  useCashWallet,
  useQuickSyncCashWallet,
} from "../hooks/useAPI";
import { type Transaction } from "../services/api";

export interface TransactionUI extends Omit<Transaction, 'id' | 'amount' | 'type'> {
  id: string | number;
  amount: number | string;
  type: "income" | "expense" | "debt" | "saving";
  category?: string;
  icon?: string;
  isPending?: boolean;
}

interface OptimisticTransaction extends Partial<TransactionUI> {
  id?: string;
  isPending?: boolean;
}

// ─── Subdued Metric Card ──────────────────────────────────────────────────────
// Theo wireframe: "HÀNG 2 — CHỈ SỐ KẾ TOÁN BỊ HẠ CẤP (DEMOTED)"
function SubduedMetricCard({
  title,
  amount,
  icon,
  note,
}: {
  title: string;
  amount: number;
  icon: React.ReactNode;
  note?: string;
}) {
  return (
    <motion.div
      data-testid="subdued-metric-card"
      whileHover={{ y: -2 }}
      transition={{ type: "spring", stiffness: 400, damping: 28 }}
      className="relative bg-slate-50 rounded-2xl px-5 py-4 border border-slate-100 hover:bg-white hover:border-slate-200 hover:shadow-sm transition-all duration-300 overflow-hidden group"
    >
      <div className="flex items-center justify-between mb-2.5">
        <p className="text-[11px] font-bold text-slate-400 tracking-wider uppercase">{title}</p>
        <div className="text-slate-300 group-hover:text-slate-400 transition-colors">
          {icon}
        </div>
      </div>
      <p className="text-[22px] font-bold text-slate-600 tracking-tight" data-testid="metric-amount">
        {formatVND(amount)}
      </p>
      {note && (
        <p className="text-[10px] text-slate-400 mt-1 font-medium">{note}</p>
      )}
    </motion.div>
  );
}

// ─── Main ─────────────────────────────────────────────────────────────────────
export default function Dashboard() {
  const [isChatOpen, setIsChatOpen] = useState(false);
  const [optimisticTransactions, setOptimisticTransactions] = useState<OptimisticTransaction[]>([]);
  const timeoutRegistry = useRef<Map<string | number, NodeJS.Timeout>>(new Map());

  // Memory Leak Prevention: Cleanup all active timeouts on unmount
  useEffect(() => {
    const registry = timeoutRegistry.current;
    return () => {
      registry.forEach((timeoutId) => clearTimeout(timeoutId));
      registry.clear();
    };
  }, []);

  // API Hooks
  const { data: finance, loading: isFinanceLoading, refetch: refetchFinance } = useFinanceData();
  const { data: txData, refetch: refetchTx } = useTransactions({ limit: 6 });
  const { data: goals } = useGoals();
  const { data: bills } = useBills();
  const { data: walletData, refetch: refetchWallet } = useCashWallet();
  const { quickSync } = useQuickSyncCashWallet();

  const handleQuickAdd = async (tx?: OptimisticTransaction | null, rollbackId?: string) => {
    // 1. Rollback Signal: Remove specific optimistic item
    if (tx === null && rollbackId) {
      setOptimisticTransactions(prev => prev.filter(t => String(t.id) !== rollbackId));
      if (timeoutRegistry.current.has(rollbackId)) {
        clearTimeout(timeoutRegistry.current.get(rollbackId));
        timeoutRegistry.current.delete(rollbackId);
      }
      return;
    }

    // 2. Optimistic Update: Insert into list immediately
    if (tx) {
      setOptimisticTransactions(prev => [{ ...tx, isPending: true }, ...prev]);
    }
    
    // 3. Background Sync
    refetchFinance();
    refetchTx();
    refetchWallet();
    
    // 4. Chaos Protection & Revalidation Sync
    if (tx && tx.id) {
      const txIdStr = String(tx.id);
      const timeoutId = setTimeout(() => {
        setOptimisticTransactions(prev => prev.filter(t => String(t.id) !== txIdStr));
        timeoutRegistry.current.delete(txIdStr);
      }, 10000); // 10s Safety Timer
      timeoutRegistry.current.set(txIdStr, timeoutId);
    }
  };

  const handleCashSync = async (newBalance: number, spent: number) => {
    try {
      await quickSync(String(newBalance), spent > 0 ? `Điều chỉnh chi tiêu: ${spent}₫` : "Cập nhật số dư");
      refetchWallet();
      refetchFinance();
    } catch (err) {
      console.error("Failed to sync wallet:", err);
    }
  };

  const containerVariants = {
    hidden: { opacity: 0 },
    show: { opacity: 1, transition: { staggerChildren: 0.06 } },
  };
  const itemVariants = {
    hidden: { opacity: 0, y: 14 },
    show: { opacity: 1, y: 0, transition: { type: "spring", stiffness: 280, damping: 22 } },
  };

  // Nếu đang load và chưa có data -> Show Skeleton
  if (isFinanceLoading && !finance) {
    return (
      <div className="bg-slate-50/30 min-h-screen p-4 pt-8" data-testid="dashboard-skeleton">
        <DashboardSkeleton />
      </div>
    );
  }

  const realRecentTx = (txData?.transactions as unknown as TransactionUI[]) || [];
  const recentTx = [...optimisticTransactions, ...realRecentTx].slice(0, 6);
  const cashBalance = Number(walletData?.balance || 0);

  // Mapping Real Data to S2S Hero
  const mappedS2SData = finance ? {
    period: "Tháng này",
    incomeDate: finance.income_date || 1,
    monthlyIncome: finance.total_income || 0,
    s2sBudget: finance.safe_to_spend || 0,
    dailyActualBurn: (txData?.transactions || []).reduce((acc, t) => acc + Number(t.amount), 0) / 30,
    emergencyBuffer: finance.emergency_buffer || 5000000,
    fixedExpenses: { total: finance.total_expense || 0, breakdown: [] },
    savingsCommitment: { total: finance.goals_allocation || 0, breakdown: [] }
  } : mockS2SData;

  return (
    <>
      <ChatQuickAdd
        isOpen={isChatOpen}
        onClose={() => setIsChatOpen(false)}
        onAdd={handleQuickAdd}
      />

      <motion.div
        variants={containerVariants as any}
        initial="hidden"
        animate="show"
        className="max-w-[1400px] mx-auto space-y-4 pb-24"
      >
        <motion.div variants={itemVariants as any}>
          <QuickInputBar onAdd={handleQuickAdd} />
        </motion.div>

        <motion.div variants={itemVariants as any} data-testid="dashboard-hero">
          <S2SHeroSection data={mappedS2SData as any} />
        </motion.div>

        <motion.div variants={itemVariants as any}>
          <div className="grid grid-cols-1 sm:grid-cols-3 gap-3">
            <SubduedMetricCard
              title="Thu Nhập Tháng"
              amount={finance?.total_income || 0}
              icon={<TrendingUp size={14} />}
              note={finance ? "Cập nhật từ hệ thống" : "Đang tính toán..."}
            />
            <SubduedMetricCard
              title="Chi Phí Dự Kiến"
              amount={finance?.total_expense || 0}
              icon={<Wallet size={14} />}
              note="Dự kiến chi tháng này"
            />
            <SubduedMetricCard
              title="Mục Tiêu Tiết Kiệm"
              amount={finance?.goals_allocation || 0}
              icon={<TrendingDown size={14} />}
              note="Cam kết tích lũy"
            />
          </div>
        </motion.div>

        <motion.div variants={itemVariants as any}>
          <CashWalletStrip
            balance={cashBalance}
            onSync={handleCashSync}
          />
        </motion.div>

        <motion.div variants={itemVariants as any}>
          <div className="grid grid-cols-1 lg:grid-cols-12 gap-4">
            <div className="lg:col-span-8 space-y-4">
              {/* Recent Transactions */}
              <div className="bg-white rounded-2xl p-6 border border-slate-100 shadow-sm shadow-black/[0.03]">
                <div className="flex items-center justify-between mb-5">
                  <h3 className="font-bold text-slate-900 text-[15px] flex items-center gap-2">
