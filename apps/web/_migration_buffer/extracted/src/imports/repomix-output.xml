                        className={`w-10 h-10 rounded-lg flex items-center justify-center text-[20px] transition-all hover:scale-110 ${formData.icon === icon ? "bg-white shadow-sm ring-2 ring-[var(--icon-color)] border-[var(--icon-color)]" : "bg-white hover:bg-slate-50"}`}
                        style={formData.icon === icon ? ({ 
