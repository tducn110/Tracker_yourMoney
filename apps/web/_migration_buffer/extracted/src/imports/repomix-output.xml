"use server";

import { revalidateTag } from "next/cache";
import { apiFetch } from "../lib/api-server";
import { InsertTransaction } from "@finance/shared-schemas";

export async function createTransactionAction(data: InsertTransaction) {
  const res = await apiFetch("/api/transactions", {
    method: "POST",
    body: JSON.stringify(data),
  });

  const result = await res.json();
  revalidateTag("transactions", "default");
  return result;
}

export async function updateTransactionAction(id: string, data: Partial<InsertTransaction>) {
  const res = await apiFetch(`/api/transactions/${id}`, {
    method: "PATCH",
    body: JSON.stringify(data),
  });

  const result = await res.json();
  revalidateTag("transactions", "default");
  return result;
}

export async function deleteTransactionAction(id: string) {
  const res = await apiFetch(`/api/transactions/${id}`, {
    method: "DELETE",
  });

  const result = await res.json();
  revalidateTag("transactions", "default");
  return result;
}

export async function quickAddTransactionAction(idempotencyKey: string, data: { text: string }) {
  const res = await apiFetch("/api/transactions/quick", {
    method: "POST",
    headers: {
      "Idempotency-Key": idempotencyKey,
    },
    body: JSON.stringify(data),
  });

  const result = await res.json();
  revalidateTag("transactions", "default");
  return result;
}
