      <div
        className="rounded-2xl p-5 h-full border"
        style={{
          backgroundColor: `${flowColor}08`,
          borderColor: `${flowColor}25`,
        }}
      >
        <div className="flex items-center gap-3 mb-4">
          <span className="text-3xl" aria-hidden="true">{step.icon}</span>
          <div>
            <p className="text-[16px] font-black text-slate-900">{step.title}</p>
            <ActorBadge actor={step.actor} />
          </div>
        </div>

        <p className="text-[13px] text-slate-700 leading-relaxed mb-4">{step.desc}</p>

        {step.details && step.details.length > 0 && (
          <div className="mb-4">
            <p className="text-[10px] font-bold uppercase tracking-wider text-slate-400 mb-2">Chi tiết</p>
            <ul className="space-y-1.5">
              {step.details.map((d, i) => (
                <li key={i} className="flex items-start gap-2">
                  <ChevronRight size={11} className="flex-shrink-0 mt-0.5" style={{ color: flowColor }} aria-hidden="true" />
                  <span className="text-[12px] text-slate-600">{d}</span>
                </li>
              ))}
            </ul>
          </div>
        )}

        {step.concern && (
          <div className="p-3 rounded-xl mb-3 bg-red-500/10 border border-red-500/20">
            <p className="text-[11px] text-red-700 font-semibold leading-relaxed">{step.concern}</p>
          </div>
        )}

        {step.stateChange && (
          <div className="p-3 rounded-xl border"
            style={{ backgroundColor: `${flowColor}10`, borderColor: `${flowColor}25` }}>
            <p className="text-[10px] font-bold uppercase tracking-wider mb-1" style={{ color: flowColor }}>
              State Change
            </p>
