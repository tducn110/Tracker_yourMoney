                    </label>
                    <div className="grid grid-cols-8 md:grid-cols-12 gap-2 max-h-48 overflow-y-auto p-3 rounded-xl" style={{ backgroundColor: "#F8FAFC" }}>
                      {ICON_PRESETS[formData.type].map((icon) => (
                        <button
