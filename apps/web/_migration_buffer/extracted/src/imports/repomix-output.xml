                        </div>
                        <div className="flex justify-between mt-1.5">
                          <span className="text-[10px] text-slate-400">{formatVND(current)}</span>
                          <span className="text-[10px] font-semibold text-slate-500">{formatVND(target)}</span>
                        </div>
                      </div>
                    );
                  }) : (
                    <div className="text-slate-400 text-[11px] py-4 text-center col-span-2">
                      Chưa có mục tiêu tiết kiệm.
                    </div>
                  )}
