"use client";

import { useState } from "react";
import { Plus, Calculator, X } from "lucide-react";
import { mockGoals, formatVND } from "../data/mockData";

type GoalStatus = "active" | "completed" | "paused";

interface Goal {
  id: number;
  name: string;
  icon: string;
  current_saved: number;
  target_amount: number;
  monthly_contribution: number;
  status: GoalStatus;
  deadline: string;
}

// Chuyển đổi từ mã Hex sang Tailwind Utility Classes
const statusConfig: Record<GoalStatus, { label: string; textClass: string; bgClass: string }> = {
  active: { label: "Đang thực hiện", textClass: "text-emerald-600", bgClass: "bg-emerald-100" },
  completed: { label: "Hoàn thành", textClass: "text-blue-600", bgClass: "bg-blue-100" },
  paused: { label: "Tạm dừng", textClass: "text-slate-500", bgClass: "bg-slate-100" },
};

export default function Goals() {
  // Mapper cưỡng ép (Data Normalization) giải quyết triệt để lỗi TS(2345)
  const [goals, setGoals] = useState<Goal[]>(() => {
    return (mockGoals as any[]).map((g) => ({
      id: Number(g.id) || Date.now() + Math.random(),
      name: g.name || "Mục tiêu không tên",
      icon: g.icon || "🎯",
      current_saved: Number(g.currentSaved ?? g.current_saved) || 0,
      target_amount: Number(g.targetAmount ?? g.target_amount) || 0,
      monthly_contribution: Number(g.monthlyContribution ?? g.monthly_contribution) || 0,
      status: (g.status as GoalStatus) || "active",
      deadline: g.deadline || "12/2027",
    }));
  });

  const [impactAmount, setImpactAmount] = useState("");
  const [impactResult, setImpactResult] = useState<string | null>(null);
  const [showNewGoalModal, setShowNewGoalModal] = useState(false);
  const [newGoal, setNewGoal] = useState({ name: "", icon: "🎯", target_amount: "", monthly_contribution: "" });

  const handleImpactCheck = () => {
    const amount = parseInt(impactAmount.replace(/\D/g, ""));
    if (!amount || goals.length === 0) return;
    const activeGoal = goals.find((g) => g.status === "active");
    if (!activeGoal) return;
    const daysDelay = Math.round((amount / activeGoal.monthly_contribution) * 30);
    setImpactResult(
      `Nếu mua ${formatVND(amount)}, mục tiêu "${activeGoal.name}" sẽ chậm lại khoảng ${daysDelay} ngày 📉`
    );
  };

  const handleAddGoal = (e: React.FormEvent) => {
    e.preventDefault();
    const g: Goal = {
      id: Date.now(),
      name: newGoal.name,
      icon: newGoal.icon,
      current_saved: 0,
      target_amount: parseInt(newGoal.target_amount.replace(/\D/g, "")) || 0,
      monthly_contribution: parseInt(newGoal.monthly_contribution.replace(/\D/g, "")) || 0,
      status: "active",
      deadline: "12/2027",
    };
    setGoals((prev) => [g, ...prev]);
    setShowNewGoalModal(false);
    setNewGoal({ name: "", icon: "🎯", target_amount: "", monthly_contribution: "" });
  };

  const toggleStatus = (id: number) => {
    setGoals((prev) =>
      prev.map((g) =>
        g.id === id
          ? { ...g, status: g.status === "active" ? "paused" : g.status === "paused" ? "active" : g.status }
          : g
      )
    );
  };

  const iconOptions = ["🎯", "📱", "✈️", "🏠", "💻", "🚗", "🎓", "💍", "🏖️", "🛡️"];

  return (
    <div className="space-y-5">
      <div className="flex items-center justify-between">
        <div>
          <h1 className="text-[24px] font-bold text-slate-800">Mục Tiêu Tiết Kiệm 🎯</h1>
          <p className="text-[14px] mt-0.5 text-slate-500">Theo dõi và quản lý mục tiêu tài chính</p>
        </div>
        <button
          onClick={() => setShowNewGoalModal(true)}
          className="flex items-center gap-2 px-4 py-2.5 rounded-xl text-white text-[14px] font-medium transition-all hover:shadow-md bg-gradient-to-br from-blue-500 to-indigo-500"
          title="Tạo mục tiêu mới"
        >
          <Plus size={15} />
          Tạo Mục Tiêu Mới
        </button>
      </div>

      {/* Stats */}
      <div className="grid grid-cols-3 gap-4">
        {[
          { label: "Đang thực hiện", value: goals.filter(g => g.status === "active").length, color: "text-emerald-500", bg: "bg-emerald-100" },
          { label: "Hoàn thành", value: goals.filter(g => g.status === "completed").length, color: "text-blue-500", bg: "bg-blue-100" },
          { label: "Tổng đã tiết kiệm", value: formatVND(goals.reduce((s, g) => s + g.current_saved, 0)), color: "text-indigo-500", bg: "bg-indigo-50" },
        ].map((stat) => (
          <div key={stat.label} className="bg-white rounded-2xl p-4 shadow-sm border border-gray-100">
            <p className="text-[12px] font-medium mb-1 text-slate-500">{stat.label}</p>
            <p className={`text-[20px] font-bold ${stat.color}`}>{stat.value}</p>
          </div>
        ))}
      </div>

      {/* Goals Grid */}
      <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
        {goals.map((goal) => {
          const percent = Math.min(Math.round((goal.current_saved / goal.target_amount) * 100), 100);
          const s = statusConfig[goal.status];
          const remaining = goal.target_amount - goal.current_saved;
          const monthsLeft = goal.monthly_contribution > 0
            ? Math.ceil(remaining / goal.monthly_contribution)
            : null;

          return (
            <div key={goal.id} className="bg-white rounded-2xl p-5 shadow-sm border border-gray-100 hover:shadow-md transition-all">
              <div className="flex items-start justify-between mb-4">
                <div className="flex items-center gap-3">
                  <div className={`w-12 h-12 rounded-xl flex items-center justify-center text-2xl ${s.bgClass}`}>
                    {goal.icon}
                  </div>
                  <div>
                    <h3 className="font-semibold text-[15px] text-slate-800">{goal.name}</h3>
                    <p className="text-[12px] text-slate-400">Deadline: {goal.deadline}</p>
                  </div>
                </div>
                <span className={`text-[10px] font-semibold px-2.5 py-1 rounded-full ${s.bgClass} ${s.textClass}`}>
                  {s.label}
                </span>
              </div>

              <div className="mb-3">
                <div className="flex justify-between text-[12px] mb-1.5 text-slate-500">
                  <span>Đã tiết kiệm: <strong className="text-emerald-500">{formatVND(goal.current_saved)}</strong></span>
                  <span className="font-semibold text-blue-500">{percent}%</span>
                </div>
                <div className="h-2.5 bg-gray-100 rounded-full overflow-hidden">
                  <div
                    className={`h-full rounded-full transition-all duration-700 ${goal.status === "completed" ? "bg-gradient-to-r from-blue-500 to-indigo-500" : "bg-gradient-to-r from-emerald-500 to-emerald-600"}`}
                    style={{ width: `${percent}%` }}
                  />
                </div>
                <div className="flex justify-between mt-1.5">
                  <p className="text-[11px] text-slate-400">
                    Mục tiêu: {formatVND(goal.target_amount)}
                  </p>
                  {monthsLeft !== null && goal.status === "active" && (
                    <p className="text-[11px] text-slate-400">
                      ~{monthsLeft} tháng nữa
                    </p>
                  )}
                </div>
              </div>

              <div className="flex items-center justify-between pt-3 border-t border-slate-100">
                <p className="text-[12px] text-slate-500">
                  Mỗi tháng góp: <strong className="text-slate-800">{formatVND(goal.monthly_contribution)}</strong>
                </p>
                {goal.status !== "completed" && (
                  <button
                    onClick={() => toggleStatus(goal.id)}
                    className={`text-[12px] font-medium px-3 py-1.5 rounded-lg hover:bg-gray-100 transition-colors ${goal.status === "active" ? "text-amber-500" : "text-emerald-500"}`}
                    aria-label={goal.status === "active" ? "Tạm dừng mục tiêu" : "Tiếp tục mục tiêu"}
                  >
                    {goal.status === "active" ? "⏸ Tạm dừng" : "▶ Tiếp tục"}
                  </button>
                )}
              </div>
            </div>
          );
        })}
      </div>

      {/* Impact Calculator */}
      <div className="bg-white rounded-2xl p-5 shadow-sm border border-gray-100">
        <div className="flex items-center gap-2 mb-4">
          <Calculator size={18} className="text-indigo-500" />
          <h3 className="font-semibold text-[16px] text-slate-800">
            Máy Tính Tác Động Chi Tiêu
          </h3>
        </div>
        <p className="text-[13px] mb-4 text-slate-500">
          Kiểm tra xem nếu bạn chi tiêu thêm một khoản, mục tiêu của bạn sẽ bị ảnh hưởng thế nào?
        </p>
        <div className="flex gap-3">
          <input
            type="text"
            value={impactAmount}
            onChange={(e) => setImpactAmount(e.target.value)}
            placeholder="Ví dụ: 500000"
            className="flex-1 px-4 py-3 rounded-xl border outline-none text-[14px] border-slate-200 bg-slate-50 text-slate-800 focus:border-indigo-500"
          />
          <button
            onClick={handleImpactCheck}
            className="px-5 py-3 rounded-xl text-white font-medium text-[14px] hover:shadow-md transition-all bg-gradient-to-br from-indigo-500 to-violet-500"
            title="Kiểm tra tác động"
          >
            Kiểm tra
          </button>
        </div>
        {impactResult && (
          <div className="mt-3 p-4 rounded-xl text-[13px] font-medium bg-indigo-50 text-indigo-600">
            💡 {impactResult}
          </div>
        )}
      </div>

      {/* New Goal Modal */}
      {showNewGoalModal && (
        <div className="fixed inset-0 z-50 flex items-center justify-center p-4">
          <div className="absolute inset-0 bg-black/50 backdrop-blur-sm" onClick={() => setShowNewGoalModal(false)} />
          <div className="relative bg-white rounded-2xl shadow-2xl w-full max-w-md p-6">
            <div className="flex items-center justify-between mb-5">
              <h2 className="font-bold text-[18px] text-slate-800">Tạo Mục Tiêu Mới 🎯</h2>
              <button
                onClick={() => setShowNewGoalModal(false)}
                className="p-2 rounded-lg hover:bg-gray-100 text-slate-500"
                title="Đóng"
                aria-label="Đóng"
              >
                <X size={18} />
              </button>
            </div>
            <form onSubmit={handleAddGoal} className="space-y-4">
              <div>
                <label className="block text-[13px] font-medium mb-1.5 text-gray-700">Icon</label>
                <div className="flex flex-wrap gap-2">
                  {iconOptions.map((ic) => (
                    <button
                      key={ic}
                      type="button"
                      onClick={() => setNewGoal({ ...newGoal, icon: ic })}
                      className={`w-10 h-10 rounded-xl text-xl border-2 transition-all ${newGoal.icon === ic ? "border-blue-500 bg-blue-50" : "border-slate-200 bg-white"}`}
                    >
                      {ic}
                    </button>
                  ))}
                </div>
              </div>
              {[
                { key: "name", label: "Tên mục tiêu", placeholder: "Mua iPhone 16 Pro" },
                { key: "target_amount", label: "Số tiền mục tiêu (₫)", placeholder: "25000000" },
                { key: "monthly_contribution", label: "Đóng góp hàng tháng (₫)", placeholder: "2000000" },
              ].map((f) => (
                <div key={f.key}>
                  <label className="block text-[13px] font-medium mb-1.5 text-gray-700">{f.label}</label>
                  <input
                    type="text"
                    value={newGoal[f.key as keyof typeof newGoal]}
                    onChange={(e) => setNewGoal({ ...newGoal, [f.key]: e.target.value })}
                    placeholder={f.placeholder}
                    className="w-full px-4 py-2.5 rounded-xl border outline-none text-[14px] border-slate-200 bg-slate-50 text-slate-800 focus:border-blue-500"
                  />
                </div>
              ))}
              <button
                type="submit"
                className="w-full py-3 rounded-xl text-white font-semibold text-[15px] hover:shadow-md transition-all bg-gradient-to-br from-blue-500 to-indigo-500"
              >
                Tạo Mục Tiêu
              </button>
            </form>
          </div>
        </div>
      )}
    </div>
  );
}
