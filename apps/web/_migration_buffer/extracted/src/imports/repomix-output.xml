    try {
      const tx = await transactionService.quickAdd(userId, text, { idempotencyKey });
      return created(c, tx);
    } catch (e) {
      if (e instanceof UnparseableInputError) {
        return err(c, 422, "unprocessable_input", e.message);
      }
      throw e;
    }
  })

  .post("/", zValidator("json", insertTransactionSchema), async (c) => {
    const userId = c.get("userId");
    const input = c.req.valid("json");
    const tx = await transactionService.createTransaction(userId, input);
    return created(c, tx);
