{
  "mcpServers": {
    "gitnexus": {
      "command": "npx",
      "args": ["-y", "gitnexus", "mcp"]
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@latest"],
      "env": {
        "CONTEXT7_API_KEY": "REPLACE_WITH_YOUR_CONTEXT7_API_KEY"
      }
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "REPLACE_WITH_YOUR_GITHUB_PAT"
      }
    },
    "sentry": {
      "command": "npx",
      "args": ["-y", "@sentry/mcp-server"],
      "env": {
        "SENTRY_ACCESS_TOKEN": "PASTE_YOUR_SENTRY_TOKEN_HERE"
      }
    },
    "tidb-server": {
      "command": "node",
      "args": ["/home/tducn/finance-for-me-local/scratch/package/build/index.js"],
      "env": {
        "TIDB_HOST": "gateway01.ap-southeast-1.prod.aws.tidbcloud.com",
        "TIDB_PORT": "4000",
        "TIDB_USER": "REPLACE_WITH_YOUR_TIDB_USER",
        "TIDB_PASS": "REPLACE_WITH_YOUR_TIDB_PASS",
        "TIDB_DB": "test",
        "ALLOW_INSERT_OPERATION": "false",
        "ALLOW_UPDATE_OPERATION": "false",
        "ALLOW_DELETE_OPERATION": "false"
      }
    }
  }
}
