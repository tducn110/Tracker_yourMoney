{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["NODE_ENV", "E2E_ADMIN_SECRET", "JWT_SECRET", "DATABASE_URL", "API_URL", "PORT", "HOSTNAME"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "db:push": {
      "cache": false
    },
    "db:generate": {
      "cache": false
    }
  }
}
