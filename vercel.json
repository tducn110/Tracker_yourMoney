{
  "version": 2,
  "buildCommand": "pnpm build",
  "installCommand": "pnpm install",
  "framework": "nextjs",
  "outputDirectory": "apps/web/.next",
  "ignoreCommand": "bash ./scripts/ignore-build.sh",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "apps/api/src/server.ts"
    }
  ]
}
