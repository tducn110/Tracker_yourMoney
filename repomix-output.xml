// packages/db/src/schema/transactions.ts
// TABLE 5: transactions — Nhật ký giao dịch tài chính (bảng cốt lõi)
//
// [v12.0-A] display_date DATE — ngày user tự chọn cho sổ cái, không có timezone confusion
