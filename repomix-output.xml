  isLoading,
  emergencyBuffer,
  setEmergencyBuffer,
  monthlyBudget,
  setMonthlyBudget,
  incomeDate,
  setIncomeDate,
  emailNotifications,
  setEmailNotifications,
  pushNotifications,
  setPushNotifications,
  onSave,
  isSaving,
  categories,
  categoriesLoading,
  isMutatingCategories,
  onCreateCategory,
  onUpdateCategory,
  onDeleteCategory,
