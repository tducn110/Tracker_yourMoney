  return (
    <div className="p-6 md:p-8 space-y-8 animate-in fade-in slide-in-from-bottom-4 duration-500">
      {/* Row 1: Budget Hero + Goals Card */}
      <div className="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
