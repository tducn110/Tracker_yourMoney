{
  "name": "@finance/db",
  "version": "1.0.0",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsc --watch",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:status": "tsx src/scripts/check-status.ts",
    "db:stamp": "tsx src/scripts/sync-migration-metadata.ts",
    "db:push": "node -e \"if(process.env.NODE_ENV==='production') { console.error('FATAL: db:push is disabled in production. Use db:migrate instead.'); process.exit(1); }\" && drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "pg": "^8.20.0",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
